# Server-only. Copy to .env locally. Never commit real values.
# Do not put these in EXPO_PUBLIC_* or VITE_* client variables.

NODE_ENV=development
PORT=3000

# Supabase (fill in Phase 2 — leave blank until a project exists)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments remain disabled until provider + legal clearance
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
